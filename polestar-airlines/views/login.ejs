<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Log in — Pole Star</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="brand">
      <svg viewBox="0 0 48 48" fill="none" width="34" height="34">
        <circle cx="24" cy="24" r="22" stroke="#f4b942" stroke-width="2"/>
        <path d="M24 6 L27 21 L42 24 L27 27 L24 42 L21 27 L6 24 L21 21 Z" fill="#f4b942"/>
        <circle cx="24" cy="24" r="3.2" fill="#102340"/>
      </svg>
      <span class="logo-word">Pole<span>Star</span></span>
    </div>
    <h1>Welcome back</h1>
    <p class="sub">Log in to manage your domestic bookings.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-error"><%= error %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn btn-solid">Log in</button>
    </form>
    <div class="auth-switch">New to Pole Star? <a href="/signup">Create an account</a></div>
  </div>
</div>
</body>
</html>
